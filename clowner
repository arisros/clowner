#!/usr/bin/env bash
#
# clowner — clone a macOS .app into a second, independent copy.
#
# macOS only: built on .app bundles, Info.plist, codesign, and PlistBuddy.
# Editing an app's Info.plist breaks its code signature, so the clone is
# re-signed ad-hoc. That is what lets two copies of the same app coexist
# with different bundle identifiers.

set -euo pipefail

VERSION="0.2.0"
SEARCH_PATHS=("/Applications" "$HOME/Applications" "/Applications/Utilities")
SUPPORT="$HOME/Library/Application Support"

usage() {
  cat <<'EOF'
clowner — clone a macOS .app with a new bundle identifier

Usage:
  clowner                          Interactive wizard (pick an app, name the clone)
  clowner clone --src <app> --name <name> [options]
  clowner list                     List apps that can be cloned
  clowner --version | --help

Clone options:
  --src <path>       Source .app bundle
  --name <name>      Name of the clone, without .app
  --id <bundle-id>   CFBundleIdentifier for the clone   (default: <name>)
  --dest <path>      Where to write the clone           (default: /Applications/<name>.app)
  --profile <path>   Isolation directory for the clone's instance
                     (default: ~/Library/Application Support/Clowner/<name>)
  --args "<flags>"   Launch flags to run the clone as its own instance. Set
                     automatically for known browsers (Chromium: --user-data-dir,
                     Firefox: -no-remote --profile); pass this for anything else.
  --no-profile       Do not wrap the executable; the clone shares the original's data
  --seed             Start the clone's profile from a copy of the original's data
                     (bookmarks, extensions, sessions; caches and locks skipped)
  --seed-from <dir>  Seed from this directory instead of the detected one
  --icon <file>      Give the clone a different icon. A .icns is used as-is; any
                     other image (PNG, JPG, ...) is converted. Use a square image.
  --keep-updater     Keep Sparkle/Keystone auto-update keys (default: strip them)
  --force            Overwrite an existing destination
  --yes              Skip the confirmation prompt

Notes:
  * The clone is signed ad-hoc: no hardened runtime, no original team ID.
  * The clone will not auto-update. Re-run clowner after the original updates.
  * Cloning App Store or /System apps is unsupported; their signatures are not
    reproducible ad-hoc and the copies usually refuse to launch.
  * Quit the original before --seed: copying a live profile can copy a
    half-written database.
EOF
}

die() { printf 'clowner: %s\n' "$1" >&2; exit 1; }
say() { printf '==> %s\n' "$1"; }
warn() { printf 'clowner: %s\n' "$1" >&2; }

plist() { /usr/libexec/PlistBuddy "$@"; }

plist_get() {
  plist -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null || true
}

# read does not expand ~, and a path dragged into a terminal arrives quoted or
# backslash-escaped. Echo a usable path, or nothing if none of the readings exist.
resolve_path() {
  local raw="$1" p
  for p in "$raw" "$(printf '%s' "$raw" | sed "s/^['\"]//; s/['\"]\$//")" "$(printf '%s' "$raw" | sed 's/\\ / /g')"; do
    case "$p" in
      "~") p="$HOME" ;;
      "~/"*) p="$HOME/${p#\~/}" ;;
    esac
    [ -e "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  return 0
}

# An app is Chromium-based if its framework ships the renderer helper.
is_chromium() {
  [ -n "$(find "$1/Contents/Frameworks" -maxdepth 5 -name '*Helper (Renderer).app' -print -quit 2>/dev/null)" ]
}

# A Firefox/Gecko app: Mozilla bundle id, or an XUL framework alongside it.
is_firefox() {
  case "$(plist_get "$1" CFBundleIdentifier)" in
    org.mozilla.*|org.torproject.*) return 0 ;;
  esac
  [ -e "$1/Contents/MacOS/firefox" ] || [ -d "$1/Contents/MacOS/XUL.framework" ]
}

# Which per-instance isolation a clone needs: a browser family that would
# otherwise hand a second copy off to the already-running instance.
app_family() {
  if is_chromium "$1"; then echo chromium
  elif is_firefox "$1"; then echo firefox
  else echo other; fi
}

app_running() {
  pgrep -f "$1/Contents/MacOS/" >/dev/null 2>&1
}

# ---------------------------------------------------------------- discovery

list_apps() {
  local dir app
  for dir in "${SEARCH_PATHS[@]}"; do
    [ -d "$dir" ] || continue
    for app in "$dir"/*.app; do
      [ -d "$app" ] || continue
      [ -f "$app/Contents/Info.plist" ] || continue
      printf '%s\n' "$app"
    done
  done
}

describe_app() {
  local app="$1" id ver kind
  id="$(plist_get "$app" CFBundleIdentifier)"
  ver="$(plist_get "$app" CFBundleShortVersionString)"
  kind="app"
  is_chromium "$app" && kind="chromium"
  printf '%-40s %-34s %-10s %s\n' "$(basename "$app" .app)" "${id:-?}" "${ver:-?}" "$kind"
}

cmd_list() {
  printf '%-40s %-34s %-10s %s\n' "NAME" "BUNDLE ID" "VERSION" "TYPE"
  local app
  while IFS= read -r app; do describe_app "$app"; done < <(list_apps)
}

# ------------------------------------------------- the original's own profile

# Firefox keeps its profiles under a per-app support directory listed nowhere in
# Info.plist; map the known forks, fall back to the bundle name.
firefox_root() {
  case "$(plist_get "$1" CFBundleIdentifier)" in
    org.mozilla.firefox|org.mozilla.firefoxdeveloperedition|org.mozilla.nightly)
      printf '%s\n' "$SUPPORT/Firefox" ;;
    org.mozilla.librewolf) printf '%s\n' "$SUPPORT/LibreWolf" ;;
    org.torproject.torbrowser) printf '%s\n' "$SUPPORT/TorBrowser-Data/Browser" ;;
    app.zen-browser.zen) printf '%s\n' "$SUPPORT/zen" ;;
    *) printf '%s\n' "$SUPPORT/$(plist_get "$1" CFBundleName)" ;;
  esac
}

# The profile directory Firefox itself would open: the one flagged Default=1 in
# profiles.ini, else the install's Default=, else the first listed.
firefox_default_profile() {
  local root ini path
  root="$(firefox_root "$1")"
  ini="$root/profiles.ini"
  [ -f "$ini" ] || return 0

  path="$(awk -F= '/^\[/{s=$0;p=""} s ~ /^\[Profile/ && $1=="Path"{p=$2} s ~ /^\[Profile/ && $1=="Default" && $2=="1"{print p; exit}' "$ini")"
  [ -n "$path" ] || path="$(awk -F= '/^\[/{s=$0} s ~ /^\[Install/ && $1=="Default"{print $2; exit}' "$ini")"
  [ -n "$path" ] || path="$(awk -F= '/^\[/{s=$0} s ~ /^\[Profile/ && $1=="Path"{print $2; exit}' "$ini")"
  [ -n "$path" ] || return 0

  case "$path" in
    /*) [ -d "$path" ] && printf '%s\n' "$path" ;;
    *)  [ -d "$root/$path" ] && printf '%s\n' "$root/$path" ;;
  esac
  return 0
}

# Where the ORIGINAL app keeps the data a clone could start from. Chromium
# records its own directory in Info.plist (CrProductDirName); older builds and
# Chrome itself do not, so the well-known ones are listed.
source_data_dir() {
  local app="$1" family="$2" dir name
  case "$family" in
    chromium)
      dir="$(plist_get "$app" CrProductDirName)"
      if [ -z "$dir" ]; then
        case "$(plist_get "$app" CFBundleIdentifier)" in
          com.google.Chrome)          dir="Google/Chrome" ;;
          com.google.Chrome.beta)     dir="Google/Chrome Beta" ;;
          com.google.Chrome.canary)   dir="Google/Chrome Canary" ;;
          com.brave.Browser)          dir="BraveSoftware/Brave-Browser" ;;
          com.brave.Browser.beta)     dir="BraveSoftware/Brave-Browser-Beta" ;;
          com.brave.Browser.nightly)  dir="BraveSoftware/Brave-Browser-Nightly" ;;
          com.microsoft.edgemac)      dir="Microsoft Edge" ;;
          com.vivaldi.Vivaldi)        dir="Vivaldi" ;;
          com.operasoftware.Opera)    dir="com.operasoftware.Opera" ;;
          company.thebrowser.Browser) dir="Arc/User Data" ;;
          *) dir="$(plist_get "$app" CFBundleName)" ;;
        esac
      fi
      [ -n "$dir" ] && [ -d "$SUPPORT/$dir" ] && printf '%s\n' "$SUPPORT/$dir"
      ;;
    firefox)
      firefox_default_profile "$app"
      ;;
    *)
      name="$(plist_get "$app" CFBundleName)"
      [ -n "$name" ] && [ -d "$SUPPORT/$name" ] && printf '%s\n' "$SUPPORT/$name"
      ;;
  esac
  return 0
}

# Caches, crash dumps and single-instance locks: regenerated on first launch,
# and a copied lock makes the clone think it is already running.
SEED_SKIP=(
  Cache "Code Cache" GPUCache DawnCache DawnGraphiteCache DawnWebGPUCache
  GrShaderCache ShaderCache CacheStorage "Service Worker/CacheStorage"
  Crashpad component_crx_cache optimization_guide_model_store
  "BrowserMetrics*" "*.pma" "Safe Browsing*" blob_storage
  "Singleton*" lockfile .parentlock lock
  cache2 startupCache
)

seed_profile() {
  local from="$1" to="$2" skip=() x status=0
  for x in "${SEED_SKIP[@]}"; do skip+=(--exclude "$x"); done
  mkdir -p "$to"
  rsync -a "${skip[@]}" "$from/" "$to/" || status=$?
  # 24: source files vanished mid-copy (the original was running). Harmless.
  [ "$status" -eq 0 ] || [ "$status" -eq 24 ] || die "could not copy $from (rsync exit $status)"
}

# ---------------------------------------------------------------- the wizard

pick_app() {
  local apps=() app
  while IFS= read -r app; do apps+=("$app"); done < <(list_apps)
  [ "${#apps[@]}" -gt 0 ] || die "no apps found in ${SEARCH_PATHS[*]}"

  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${apps[@]}" | fzf \
      --prompt='clone which app? ' \
      --height=60% --reverse --border \
      --preview='/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" {}/Contents/Info.plist 2>/dev/null; /usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" {}/Contents/Info.plist 2>/dev/null' \
      --preview-window=down:3
    return
  fi

  printf 'Pick an app to clone:\n' >&2
  local choice
  select choice in "${apps[@]}"; do
    [ -n "${choice:-}" ] && { printf '%s\n' "$choice"; return; }
  done
}

ICON_EXTS='png|jpg|jpeg|icns|tiff|tif|heic|gif|bmp|webp'
ICON_DIRS=("$HOME/Desktop" "$HOME/Downloads" "$HOME/Pictures" "$PWD")
ICON_KEEP='keep the original icon'

# Echo a chosen icon image path, or nothing to keep the original. Lists image
# files from a few common folders; fzf when available, numbered menu otherwise.
# In both, you can type a path directly for an image that lives elsewhere.
pick_icon() {
  local imgs=() f
  while IFS= read -r f; do imgs+=("$f"); done < <(
    find "${ICON_DIRS[@]}" -maxdepth 2 -type f 2>/dev/null \
      | grep -iE "\.($ICON_EXTS)\$" | sort -u
  )

  if command -v fzf >/dev/null 2>&1; then
    local out status=0 query choice
    out="$( { printf '%s\n' "$ICON_KEEP"; \
              if [ "${#imgs[@]}" -gt 0 ]; then printf '%s\n' "${imgs[@]}"; fi; } | fzf \
      --prompt='icon (pick one, or type a path): ' --print-query --height=60% --reverse --border \
      --preview='sips -g pixelWidth -g pixelHeight "{}" 2>/dev/null | tail -2' \
      --preview-window=down:3 )" || status=$?
    query="$(printf '%s\n' "$out" | sed -n 1p)"
    choice="$(printf '%s\n' "$out" | sed -n 2p)"

    case "$status" in
      0)   # something in the list was picked
        [ "$choice" = "$ICON_KEEP" ] || validated_icon "$choice" ;;
      1)   # no list entry matched, so the query is meant to be a path
        [ -n "$query" ] && validated_icon "$query" ;;
      *) ;; # 130 = escaped out; keep the original
    esac
    return 0
  fi

  if [ "${#imgs[@]}" -eq 0 ]; then
    local p
    read -r -p "Icon image path (blank to keep original): " p </dev/tty
    [ -n "$p" ] && validated_icon "$p"
    return 0
  fi
  printf 'Choose an icon:\n' >&2
  local choice
  select choice in "${imgs[@]}" "Type a path…" "Keep original icon"; do
    case "$choice" in
      "Keep original icon"|"") return 0 ;;
      "Type a path…")
        read -r -p "Icon image path: " choice </dev/tty
        [ -n "$choice" ] && validated_icon "$choice"; return 0 ;;
      *) validated_icon "$choice"; return 0 ;;
    esac
  done
}

# Echo the image if it exists; otherwise say so, loudly, and echo nothing. A
# typo used to disappear here and the clone came out with the original's icon.
validated_icon() {
  local p
  p="$(resolve_path "$1")"
  if [ -n "$p" ] && [ -f "$p" ]; then
    printf '%s\n' "$p"
  else
    warn "no such image: $1 (keeping the original icon)"
  fi
  return 0
}

ask() { # ask <prompt> <default> -> stdout
  local answer
  read -r -p "$1 [$2]: " answer </dev/tty
  printf '%s\n' "${answer:-$2}"
}

confirm() { # confirm <prompt> -> 0 if yes
  local answer
  read -r -p "$1 [y/N]: " answer </dev/tty
  case "$answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

cmd_wizard() {
  local src name id dest profile family

  src="$(pick_app </dev/tty)"
  [ -n "$src" ] || die "nothing selected"
  [ -d "$src" ] || die "not an app bundle: $src"

  family="$(app_family "$src")"

  printf '\n  source:    %s\n' "$src"
  printf '  bundle id: %s\n' "$(plist_get "$src" CFBundleIdentifier)"
  printf '  type:      %s\n\n' "$family"

  local base
  base="$(basename "$src" .app | tr ' ' '_' | tr '[:upper:]' '[:lower:]')"
  name="$(ask 'Name of the clone' "${base}_2")"
  id="$(ask 'Bundle identifier' "$name")"
  dest="$(ask 'Install to' "/Applications/$name.app")"

  local args=(--src "$src" --name "$name" --id "$id" --dest "$dest")
  if [ "$family" != "other" ]; then
    profile="$(ask 'Separate profile directory (- for none)' "$SUPPORT/Clowner/$name")"
    if [ "$profile" = "-" ]; then
      args+=(--no-profile)
    else
      args+=(--profile "$profile")

      local from
      from="$(source_data_dir "$src" "$family")"
      if [ -n "$from" ]; then
        printf '\n  %s keeps its data in:\n    %s\n' "$(basename "$src" .app)" "$from"
        printf '  Copying it gives the clone the same bookmarks, extensions and logins.\n'
        app_running "$src" && printf '  NOTE: %s is running; quit it first for a clean copy.\n' "$(basename "$src" .app)"
        confirm "  Start the clone from a copy of that data?" && args+=(--seed-from "$from")
      fi
    fi
  fi

  local icon
  icon="$(pick_icon </dev/tty)"
  [ -n "$icon" ] && args+=(--icon "$icon")

  printf '\n'
  cmd_clone "${args[@]}"
}

# ---------------------------------------------------------------- signing

resign_adhoc() {
  local clone="$1"

  # Ad-hoc deep sign, dropping all entitlements. This is deliberate, not a
  # shortcut: the original app's entitlements (application-identifier,
  # keychain-access-groups, com.apple.developer.*) are scoped to the vendor's
  # Team ID. An ad-hoc signature has no team, so a process that CLAIMS them
  # cannot prove them and taskgated kills it at launch. Carrying them over was
  # tested and makes the clone exit immediately. Dropping them keeps the clone
  # launchable; the visible cost is a one-time keychain-access prompt on first
  # run (click "Always Allow"), because the clone is a new signing identity and
  # cannot silently reuse the original's keychain items.
  codesign --force --deep --sign - "$clone" >/dev/null 2>&1
}

# Replace the clone's icon with $img. The icon lives inside Contents/Resources
# and is sealed by the signature, so this must run BEFORE resign_adhoc. An .icns
# is used as-is; any other image is converted to a multi-resolution .icns via an
# iconset (falling back to a single sips conversion).
set_icon() {
  local clone="$1" img="$2"
  local info="$clone/Contents/Info.plist" iconkey target
  iconkey="$(plist -c 'Print :CFBundleIconFile' "$info" 2>/dev/null)" || iconkey=""
  [ -n "$iconkey" ] || iconkey="app"
  case "$iconkey" in *.icns) ;; *) iconkey="$iconkey.icns" ;; esac
  target="$clone/Contents/Resources/$iconkey"

  # Modern apps load their icon from a compiled asset catalog (Assets.car) via
  # CFBundleIconName, which overrides the .icns. Drop that key so our .icns wins.
  # (The catalog stays in place; it just stops being the icon source.)
  plist -c "Delete :CFBundleIconName" "$info" 2>/dev/null || true
  # An app with no CFBundleIconFile at all (icon only in the catalog) needs the
  # key added, or nothing points at the file we just wrote.
  plist -c "Set :CFBundleIconFile $iconkey" "$info" 2>/dev/null \
    || plist -c "Add :CFBundleIconFile string $iconkey" "$info" 2>/dev/null || true

  mkdir -p "$clone/Contents/Resources"
  case "$img" in
    *.icns|*.ICNS)
      cp "$img" "$target"
      ;;
    *)
      local set_dir sz
      set_dir="$(mktemp -d "${TMPDIR:-/tmp}/clowner-icon.XXXXXX")/icon.iconset"
      mkdir -p "$set_dir"
      # Standard iconset sizes (1x and 2x). Any that fail are skipped.
      for sz in 16 32 128 256 512; do
        sips -s format png -z "$sz" "$sz" "$img" --out "$set_dir/icon_${sz}x${sz}.png" >/dev/null 2>&1 || true
        sips -s format png -z $((sz*2)) $((sz*2)) "$img" --out "$set_dir/icon_${sz}x${sz}@2x.png" >/dev/null 2>&1 || true
      done
      if ! iconutil -c icns "$set_dir" -o "$target" >/dev/null 2>&1; then
        # Fallback: single-shot conversion (lower quality, but works).
        sips -s format icns "$img" --out "$target" >/dev/null 2>&1 \
          || die "could not convert $img to .icns"
      fi
      rm -rf "$(dirname "$set_dir")"
      ;;
  esac
  [ -s "$target" ] || die "icon conversion produced an empty $iconkey from $img"
}

# macOS caches icons and names per bundle path, so a fresh clone at a path that
# held an older one shows the old icon until Launch Services is told otherwise.
refresh_launch_services() {
  local app="$1"
  local lsr=/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister
  touch "$app" 2>/dev/null || true
  [ -x "$lsr" ] && "$lsr" -f "$app" >/dev/null 2>&1
  return 0
}

# ---------------------------------------------------------------- the clone

cmd_clone() {
  local src="" name="" bundle_id="" dest="" profile="" old_id icon=""
  local wrap=auto wrap_args="" wrap_args_set=0 keep_updater=0 force=0 assume_yes=0
  local seed=0 seed_from=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --src) src="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      --id) bundle_id="${2:-}"; shift 2 ;;
      --dest) dest="${2:-}"; shift 2 ;;
      --profile) profile="${2:-}"; wrap=yes; shift 2 ;;
      --args) wrap_args="${2:-}"; wrap_args_set=1; wrap=yes; shift 2 ;;
      --no-profile) wrap=no; shift ;;
      --seed) seed=1; shift ;;
      --seed-from) seed_from="${2:-}"; seed=1; shift 2 ;;
      --icon) icon="${2:-}"; shift 2 ;;
      --keep-updater) keep_updater=1; shift ;;
      --force) force=1; shift ;;
      --yes|-y) assume_yes=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  [ -n "$src" ] || die "--src is required"
  [ -n "$name" ] || die "--name is required"
  [ -d "$src" ] && [ -f "$src/Contents/Info.plist" ] || die "not an app bundle: $src"
  if [ -n "$icon" ]; then
    icon="$(resolve_path "$icon")"
    [ -n "$icon" ] && [ -f "$icon" ] || die "icon file not found: $icon"
  fi

  bundle_id="${bundle_id:-$name}"
  dest="${dest:-/Applications/$name.app}"
  old_id="$(plist -c 'Print :CFBundleIdentifier' "$src/Contents/Info.plist")"

  local family
  family="$(app_family "$src")"

  # Whether to wrap the executable so the clone runs as its own instance. The
  # core clone (copy + re-id + re-sign) is generic; wrapping is an optional
  # add-on. It auto-enables only for browser families that would otherwise hand
  # a second copy off to the running one — everything else clones bare unless
  # you ask for a wrapper with --args.
  if [ "$wrap" = auto ]; then
    if [ "$family" = "other" ]; then wrap=no; else wrap=yes; fi
  fi
  if [ "$wrap" = yes ]; then
    profile="${profile:-$SUPPORT/Clowner/$name}"
    # Flags that give the clone a separate instance. Supplied generically with
    # --args (any app), or filled in from a known browser family as a default.
    if [ "$wrap_args_set" -eq 0 ]; then
      case "$family" in
        chromium) wrap_args="--user-data-dir=\"$profile\"" ;;
        firefox)  wrap_args="-no-remote --profile \"$profile\"" ;;
        *) die "don't know how to isolate a '$family' app — pass the launch flags yourself with --args \"...\", or --no-profile to clone bare" ;;
      esac
    fi
  fi

  if [ "$seed" -eq 1 ]; then
    [ "$wrap" = yes ] || die "--seed needs a profile of its own; drop --no-profile"
    [ -n "$profile" ] || die "--seed needs --profile"
    if [ -n "$seed_from" ]; then
      seed_from="$(resolve_path "$seed_from")"
      [ -n "$seed_from" ] && [ -d "$seed_from" ] || die "seed directory not found"
    else
      seed_from="$(source_data_dir "$src" "$family")"
      [ -n "$seed_from" ] || die "could not find where $(basename "$src" .app) keeps its data (pass --seed-from <dir>)"
    fi
  fi

  if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
    die "destination exists: $dest (use --force to overwrite)"
  fi

  printf '  %-11s %s\n' "source:" "$src"
  printf '  %-11s %s\n' "clone:" "$dest"
  printf '  %-11s %s -> %s\n' "bundle id:" "$old_id" "$bundle_id"
  [ "$wrap" = yes ] && printf '  %-11s %s\n' "wrap:" "$wrap_args"
  [ "$seed" -eq 1 ] && printf '  %-11s %s\n' "seed:" "$seed_from"
  if [ -n "$icon" ]; then
    printf '  %-11s %s\n' "icon:" "$icon"
  else
    printf '  %-11s %s\n' "icon:" "(keeping the original's)"
  fi
  printf '\n'

  if [ "$seed" -eq 1 ] && app_running "$src"; then
    warn "$(basename "$src" .app) is running, so its profile may be copied half-written"
  fi

  if [ "$assume_yes" -eq 0 ]; then
    local go
    read -r -p "Proceed? [y/N]: " go </dev/tty
    case "$go" in y|Y|yes|YES) ;; *) die "aborted" ;; esac
  fi

  [ -e "$dest" ] && { say "Removing $dest"; rm -rf "$dest"; }

  say "Copying"
  mkdir -p "$(dirname "$dest")"
  cp -a "$src" "$dest"

  say "Rewriting bundle identifiers ($old_id -> $bundle_id)"
  local info id new_id
  while IFS= read -r info; do
    id="$(plist -c 'Print :CFBundleIdentifier' "$info" 2>/dev/null)" || continue
    case "$id" in
      "$old_id"|"$old_id".*)
        new_id="$bundle_id${id#"$old_id"}"
        plist -c "Set :CFBundleIdentifier $new_id" "$info"
        printf '    %s -> %s\n' "$id" "$new_id"
        ;;
    esac
  done < <(find "$dest" -name Info.plist -type f)

  plist -c "Set :CFBundleName $name" "$dest/Contents/Info.plist" 2>/dev/null || true
  plist -c "Set :CFBundleDisplayName $name" "$dest/Contents/Info.plist" 2>/dev/null || true

  # Many apps localize their display name in Contents/Resources/*.lproj/
  # InfoPlist.strings, and that value WINS over Info.plist — so the menu bar and
  # Finder keep showing the original name unless we rewrite these too.
  local strings n=0
  while IFS= read -r strings; do
    local key changed=0
    for key in CFBundleName CFBundleDisplayName; do
      if plutil -extract "$key" raw "$strings" >/dev/null 2>&1; then
        plutil -replace "$key" -string "$name" "$strings" >/dev/null 2>&1 && changed=1
      fi
    done
    [ "$changed" -eq 1 ] && n=$((n+1))
  done < <(find "$dest/Contents/Resources" -name InfoPlist.strings -type f 2>/dev/null)
  [ "$n" -gt 0 ] && say "Renamed in $n localized InfoPlist.strings"

  if [ "$keep_updater" -eq 0 ]; then
    say "Stripping auto-update keys"
    local key
    for key in KSProductID KSUpdateURL KSVersion KSChannelID SUFeedURL SUEnableAutomaticChecks; do
      plist -c "Delete :$key" "$dest/Contents/Info.plist" 2>/dev/null || true
    done
  fi

  if [ "$wrap" = yes ]; then
    say "Wrapping the executable ($wrap_args)"
    local exe bin_dir real
    exe="$(plist -c 'Print :CFBundleExecutable' "$dest/Contents/Info.plist")"
    bin_dir="$dest/Contents/MacOS"
    real="$exe-clowner"
    [ -n "$profile" ] && mkdir -p "$profile"
    mv "$bin_dir/$exe" "$bin_dir/$real"
    cat > "$bin_dir/$exe" <<EOF
#!/bin/sh
# Generated by clowner — runs the clone as its own instance.
exec "\$(dirname "\$0")/$real" $wrap_args "\$@"
EOF
    chmod +x "$bin_dir/$exe"
  fi

  if [ "$seed" -eq 1 ]; then
    say "Seeding profile from $seed_from"
    seed_profile "$seed_from" "$profile"
  fi

  if [ -n "$icon" ]; then
    say "Setting icon ($icon)"
    set_icon "$dest" "$icon"
  fi

  say "Signing ad-hoc"
  xattr -cr "$dest" 2>/dev/null || true
  resign_adhoc "$dest"

  say "Refreshing Launch Services"
  refresh_launch_services "$dest"

  say "Done"
  codesign -dv "$dest" 2>&1 | grep -E 'Identifier=|Signature=' | sed 's/^/    /' || true
  printf '    run: open -a "%s"\n' "$dest"
  [ -n "$icon" ] && printf '    if the old icon lingers: killall Dock Finder\n'
  return 0
}

# ---------------------------------------------------------------- entrypoint

case "${1:-}" in
  "")           cmd_wizard ;;
  clone)        shift; cmd_clone "$@" ;;
  list)         cmd_list ;;
  -h|--help)    usage ;;
  --version|-V) printf 'clowner %s\n' "$VERSION" ;;
  *)            die "unknown command: $1 (try --help)" ;;
esac
